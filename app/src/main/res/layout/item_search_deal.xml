<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginStart="14dp" android:layout_marginEnd="14dp"
    android:layout_marginTop="6dp" android:layout_marginBottom="6dp"
    app:cardBackgroundColor="@color/card_grey"
    app:cardCornerRadius="22dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <FrameLayout
            android:layout_width="96dp" android:layout_height="112dp"
            android:background="@drawable/bg_image_placeholder"
            android:clipToOutline="true">
            <ImageView
                android:id="@+id/ivDeal"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="6dp"
                android:background="@drawable/bg_badge"
                android:drawableStart="@drawable/ic_clock"
                android:drawablePadding="3dp"
                android:drawableTint="@color/white"
                android:gravity="center_vertical"
                android:paddingStart="6dp" android:paddingEnd="8dp"
                android:paddingTop="3dp" android:paddingBottom="3dp"
                android:text="Ended just now"
                android:textColor="@color/white" android:textSize="8sp"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp" android:layout_height="112dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp" android:paddingEnd="6dp">

            <TextView android:id="@+id/tvCategory"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textAllCaps="true" android:textSize="8sp"
                android:textColor="#444444"/>
            <TextView android:id="@+id/tvDealTitle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/brand_red" android:textSize="17sp"
                android:textStyle="bold"/>
            <TextView android:id="@+id/tvDescription"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_dark" android:textSize="9sp"/>

            <Space android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1"/>

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="NOW" android:textSize="7sp"
                        android:textColor="#444444"/>
                    <TextView android:id="@+id/tvNow"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/price_green" android:textSize="24sp"
                        android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:gravity="end" android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="MISSED" android:textSize="7sp"
                        android:textColor="#444444"/>
                    <TextView android:id="@+id/tvMissed"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginBottom="3dp"
                        android:textColor="@color/brand_red" android:textSize="11sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>